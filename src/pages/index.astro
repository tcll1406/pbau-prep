---
import Base from '../layouts/Base.astro';
---

<Base title="PBAU Prep">
	<main>
		<h1>PBAU Prep</h1>
		<p class="mission">
			Prepara la PBAU a les Illes Balears i aconsegueix la nota màxima.
		</p>

		<div class="cta">
			<a class="btn btn-primary" href="/learning">Learning Hub</a>
			<a class="btn btn-secondary" href="/career">Career Hub</a>
		</div>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 5rem 1.5rem;
		line-height: 1.6;
		text-align: center;
	}

	h1 {
		font-size: 3rem;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
	}

	.mission {
		font-size: 1.25rem;
		color: var(--text-muted);
		margin-bottom: 2.5rem;
	}

	.cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 0.9rem 1.75rem;
		border-radius: var(--radius-sm);
		text-decoration: none;
		font-weight: 600;
		font-size: 1.1rem;
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.btn:hover {
		transform: translateY(-3px);
	}

	.btn-primary {
		background: var(--accent);
		color: #fff;
	}

	.btn-primary:hover {
		box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
	}

	.btn-secondary {
		background: var(--surface);
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-secondary:hover {
		background: var(--surface-hover);
	}
</style>
