---
import Base from '../layouts/Base.astro';
---

<Base title="PBAU Prep">
	<main>
		<h1>PBAU Prep</h1>
		<p class="mission">
			Prepara la PBAU a les Illes Balears i aconsegueix la nota màxima.
		</p>

		<div class="cta">
			<a class="btn btn-primary" href="/learning">Learning Hub</a>
			<a class="btn btn-secondary" href="/career">Career Hub</a>
		</div>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
		text-align: center;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.mission {
		font-size: 1.25rem;
		color: #444;
		margin-bottom: 2rem;
	}

	.cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 0.9rem 1.75rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 1.1rem;
	}

	.btn-primary {
		background: #1a1a2e;
		color: #fff;
	}

	.btn-secondary {
		background: #eee;
		color: #1a1a2e;
	}
</style>
