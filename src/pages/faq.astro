---
import Base from '../layouts/Base.astro';
import { FAQ_ITEMS } from '../data/faq';
---

<Base title="FAQ">
	<main>
		<h1>Preguntes freqüents</h1>

		<div class="accordion">
			{FAQ_ITEMS.map((item) => (
				<details>
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 1.5rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
	}

	.accordion {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	details {
		border: 1px solid #ddd;
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
	}

	summary {
		font-weight: 600;
		cursor: pointer;
	}

	details p {
		margin-top: 0.75rem;
		margin-bottom: 0;
		color: #333;
	}
</style>
