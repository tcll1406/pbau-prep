---
import Base from '../layouts/Base.astro';
import { FAQ_ITEMS } from '../data/faq';
---

<Base title="FAQ">
	<main>
		<h1>Preguntes freqüents</h1>

		<div class="accordion">
			{FAQ_ITEMS.map((item) => (
				<details>
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	h1 {
		letter-spacing: -0.02em;
	}

	.accordion {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	details {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.75rem 1rem;
	}

	summary {
		font-weight: 600;
		cursor: pointer;
	}

	details p {
		margin-top: 0.75rem;
		margin-bottom: 0;
		color: var(--text-muted);
	}
</style>
