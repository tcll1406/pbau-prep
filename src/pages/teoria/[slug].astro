---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TeoriaPage from '../../components/TeoriaPage.astro';

export async function getStaticPaths() {
	const entries = await getCollection('teoria', (entry) => !entry.id.startsWith('es/'));
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<Base
	title={entry.data.title}
	description={`Resum de teoria de ${entry.data.title} amb fórmules i conceptes clau per a la PAU.`}
>
	<TeoriaPage entry={entry} />
</Base>
