---
import Base from '../../layouts/Base.astro';
import LearningSubjectPage from '../../components/LearningSubjectPage.astro';
import { EXAM_SUBJECTS } from '../../data/examens';

export async function getStaticPaths() {
	return EXAM_SUBJECTS.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
---

<Base
	title={subject.label.ca}
	description={`Teoria, qüestionaris i exàmens anteriors de ${subject.label.ca} per preparar la PAU.`}
>
	<LearningSubjectPage subject={subject} lang="ca" />
</Base>
