---
import Base from '../../layouts/Base.astro';
import { EXAM_SUBJECTS } from '../../data/examens';
import { getSubjectTopics } from '../../data/subjects';

export async function getStaticPaths() {
	return EXAM_SUBJECTS.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
const topics = getSubjectTopics(subject.slug);
---

<Base title={subject.label}>
	<main>
		<h1>{subject.label}</h1>

		<section>
			<h2>Teoria</h2>
			<p>Resum complet de la teoria, amb totes les fórmules i conceptes clau.</p>
			<a class="link-card" href={`/teoria/${subject.slug}`}>Llegeix el resum complet →</a>
		</section>

		<section>
			<h2>Qüestionaris</h2>
			<p>5 qüestionaris per practicar cada tema, o el qüestionari complet amb totes les preguntes.</p>
			<a class="link-card" href={`/learning/${subject.slug}/quiz`}>Fes el qüestionari complet →</a>
			<ul class="topics">
				{topics.map((topic) => (
					<li>
						<a href={`/learning/${subject.slug}/quiz/${topic.slug}`}>{topic.label}</a>
					</li>
				))}
			</ul>
		</section>

		<section>
			<h2>Exàmens anteriors</h2>
			<p>Enunciats i criteris de correcció oficials de la UIB.</p>
			<a class="link-card" href={`/examens/${subject.slug}`}>Veure els exàmens anteriors →</a>
		</section>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	h1 {
		letter-spacing: -0.02em;
	}

	section {
		margin-bottom: 2.5rem;
	}

	section p {
		color: var(--text-muted);
	}

	.link-card {
		display: inline-block;
		margin-top: 0.5rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--accent-strong);
		transition: transform 0.2s;
	}

	.link-card:hover {
		transform: translateX(3px);
	}

	.topics {
		list-style: none;
		padding: 0;
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.topics li a {
		display: block;
		padding: 0.75rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.2s;
	}

	.topics li a:hover {
		border-color: var(--accent);
	}
</style>
