---
import Base from '../../layouts/Base.astro';
import { EXAM_SUBJECTS } from '../../data/examens';
---

<Base title="Learning Hub">
	<main>
		<h1>Learning Hub</h1>
		<p>Tria una assignatura per accedir a la teoria, els qüestionaris i els exàmens anteriors.</p>

		<ul class="subjects">
			{EXAM_SUBJECTS.map((s) => (
				<li><a href={`/learning/${s.slug}`}>{s.label}</a></li>
			))}
		</ul>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	h1 {
		letter-spacing: -0.02em;
	}

	.subjects {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.subjects a {
		display: block;
		padding: 1.1rem 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--text);
		font-weight: 600;
		transition: transform 0.2s, background 0.2s;
	}

	.subjects a:hover {
		background: var(--surface-hover);
		transform: translateY(-3px);
	}
</style>
