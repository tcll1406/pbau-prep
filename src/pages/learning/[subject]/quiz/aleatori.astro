---
import Base from '../../../../layouts/Base.astro';
import Quiz from '../../../../components/Quiz.astro';
import { EXAM_SUBJECTS } from '../../../../data/examens';
import { fetchQuestions } from '../../../../lib/questions';

export async function getStaticPaths() {
	return Promise.all(
		EXAM_SUBJECTS.map(async (subject) => ({
			params: { subject: subject.slug },
			props: { subject, questions: await fetchQuestions({ subject: subject.slug }) },
		}))
	);
}

const { subject, questions } = Astro.props;
---

<Base title={`Qüestionari aleatori — ${subject.label}`}>
	<main>
		<a class="back" href={`/learning/${subject.slug}/quiz`}>← {subject.label}</a>
		<h1>Qüestionari aleatori</h1>
		<p class="intro">10 preguntes triades a l'atzar d'entre totes les de {subject.label}.</p>

		<Quiz questions={questions} manualInit={true} />
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	.back {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.back:hover {
		color: var(--text);
	}

	h1 {
		letter-spacing: -0.02em;
	}

	.intro {
		color: var(--text-muted);
		margin-bottom: 2rem;
	}
</style>

<script>
	import { applyQuizFilter, getAllRenderedQuestionIds } from '../../../../lib/quiz-filter-client';

	const ids = getAllRenderedQuestionIds();
	for (let i = ids.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1));
		[ids[i], ids[j]] = [ids[j], ids[i]];
	}

	applyQuizFilter(new Set(ids.slice(0, 10)));
</script>
