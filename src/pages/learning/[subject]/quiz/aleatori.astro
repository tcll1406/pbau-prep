---
import Base from '../../../../layouts/Base.astro';
import AleatoriQuizPage from '../../../../components/AleatoriQuizPage.astro';
import { EXAM_SUBJECTS } from '../../../../data/examens';
import { fetchQuestions } from '../../../../lib/questions';

export async function getStaticPaths() {
	return Promise.all(
		EXAM_SUBJECTS.map(async (subject) => ({
			params: { subject: subject.slug },
			props: { subject, questions: await fetchQuestions({ subject: subject.slug }, 'ca') },
		}))
	);
}

const { subject, questions } = Astro.props;
---

<Base
	title={`Qüestionari aleatori — ${subject.label.ca}`}
	description={`10 preguntes a l'atzar de tots els temes de ${subject.label.ca}.`}
>
	<AleatoriQuizPage subject={subject} questions={questions} lang="ca" />
</Base>
