---
import Base from '../../../../layouts/Base.astro';
import ErrorsQuizPage from '../../../../components/ErrorsQuizPage.astro';
import { EXAM_SUBJECTS } from '../../../../data/examens';
import { fetchQuestions } from '../../../../lib/questions';

export async function getStaticPaths() {
	return Promise.all(
		EXAM_SUBJECTS.map(async (subject) => ({
			params: { subject: subject.slug },
			props: { subject, questions: await fetchQuestions({ subject: subject.slug }, 'ca') },
		}))
	);
}

const { subject, questions } = Astro.props;
---

<Base
	title={`Test d'errors — ${subject.label.ca}`}
	description={`Repassa les preguntes de ${subject.label.ca} que has fallat anteriorment.`}
>
	<ErrorsQuizPage subject={subject} questions={questions} lang="ca" />
</Base>
