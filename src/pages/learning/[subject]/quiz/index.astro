---
import Base from '../../../../layouts/Base.astro';
import QuizIndexPage from '../../../../components/QuizIndexPage.astro';
import { EXAM_SUBJECTS } from '../../../../data/examens';

export async function getStaticPaths() {
	return EXAM_SUBJECTS.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
---

<Base
	title={`Qüestionaris — ${subject.label.ca}`}
	description={`Practica ${subject.label.ca} per tema, a l'atzar, o repassa el teu test d'errors.`}
>
	<QuizIndexPage subject={subject} lang="ca" />
</Base>
