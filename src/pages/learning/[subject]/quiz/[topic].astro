---
import Base from '../../../../layouts/Base.astro';
import TopicQuizPage from '../../../../components/TopicQuizPage.astro';
import { EXAM_SUBJECTS } from '../../../../data/examens';
import { getSubjectTopics } from '../../../../data/subjects';
import { fetchQuestions } from '../../../../lib/questions';

export async function getStaticPaths() {
	const paths = [];
	for (const subject of EXAM_SUBJECTS) {
		for (const topic of getSubjectTopics(subject.slug, 'ca')) {
			paths.push({
				params: { subject: subject.slug, topic: topic.slug },
				props: {
					subject,
					topic,
					questions: await fetchQuestions({ subject: subject.slug, topic: topic.caLabel }, 'ca'),
				},
			});
		}
	}
	return paths;
}

const { subject, topic, questions } = Astro.props;
---

<Base
	title={`${topic.label} — ${subject.label.ca}`}
	description={`10 preguntes sobre ${topic.label} (${subject.label.ca}) amb correcció instantània i explicacions.`}
>
	<TopicQuizPage subject={subject} topic={topic} questions={questions} lang="ca" />
</Base>
