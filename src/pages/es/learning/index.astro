---
import Base from '../../../layouts/Base.astro';
import { EXAM_SUBJECTS } from '../../../data/examens';
import { ICONS } from '../../../data/icons';

const SUBJECT_ICONS: Record<string, string> = {
	fisica: ICONS.atom,
	'matematiques-ii': ICONS.function,
	'macs-ii': ICONS.chart,
};
---

<Base
	title="Learning Hub — Teoría, tests y exámenes PAU"
	lang="es"
	description="Elige una asignatura — Física, Matemáticas II o MACS II — y accede a la teoría, los cuestionarios y los exámenes anteriores."
>
	<main>
		<h1>Learning Hub</h1>
		<p>Elige una asignatura para acceder a la teoría, los cuestionarios y los exámenes anteriores.</p>

		<div class="subjects">
			{EXAM_SUBJECTS.map((s) => (
				<a class="subject-card" href={`/es/learning/${s.slug}`}>
					<span class="icon" set:html={SUBJECT_ICONS[s.slug]} />
					<span class="label">{s.label.es}</span>
				</a>
			))}
		</div>
	</main>
</Base>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	h1 {
		letter-spacing: -0.02em;
	}

	.subjects {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-top: 1.5rem;
	}

	@media (max-width: 48rem) {
		.subjects {
			grid-template-columns: 1fr;
		}
	}

	.subject-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
		padding: 2rem 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--text);
		font-weight: 600;
		transition: transform 0.2s, background 0.2s;
	}

	.subject-card:hover {
		background: var(--surface-hover);
		transform: translateY(-3px);
	}

	.subject-card .icon {
		width: 2.5rem;
		height: 2.5rem;
		color: var(--accent-strong);
	}
</style>
