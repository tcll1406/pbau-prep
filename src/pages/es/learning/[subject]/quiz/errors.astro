---
import Base from '../../../../../layouts/Base.astro';
import ErrorsQuizPage from '../../../../../components/ErrorsQuizPage.astro';
import { EXAM_SUBJECTS } from '../../../../../data/examens';
import { fetchQuestions } from '../../../../../lib/questions';

export async function getStaticPaths() {
	return Promise.all(
		EXAM_SUBJECTS.map(async (subject) => ({
			params: { subject: subject.slug },
			props: { subject, questions: await fetchQuestions({ subject: subject.slug }, 'es') },
		}))
	);
}

const { subject, questions } = Astro.props;
---

<Base
	title={`Test de errores — ${subject.label.es}`}
	lang="es"
	description={`Repasa las preguntas de ${subject.label.es} que has fallado anteriormente.`}
>
	<ErrorsQuizPage subject={subject} questions={questions} lang="es" />
</Base>
