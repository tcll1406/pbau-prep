---
import Base from '../../layouts/Base.astro';
import { EXAM_SUBJECTS, OFFICIAL_DOCS, getExamArchive } from '../../data/examens';

export async function getStaticPaths() {
	return EXAM_SUBJECTS.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
const archive = getExamArchive(subject.slug);
const officialDocs = OFFICIAL_DOCS[subject.slug] ?? [];
---

<Base title={`Exàmens anteriors — ${subject.label}`}>
	<main>
		<h1>Exàmens anteriors — {subject.label}</h1>

		{archive.map((yearGroup) => (
			<section>
				<h2>{yearGroup.year}</h2>
				<ul>
					{yearGroup.convocatories.map((c) => (
						<li>
							{c.label}:
							<a href={c.enunciatUrl}>Enunciat</a>
							·
							<a href={c.criterisUrl}>Criteris</a>
						</li>
					))}
				</ul>
			</section>
		))}

		<section>
			<h2>Documents oficials</h2>
			<ul>
				{officialDocs.map((doc) => (
					<li><a href={doc.url}>{doc.label}</a></li>
				))}
			</ul>
		</section>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	h1 {
		letter-spacing: -0.02em;
	}

	section {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem 1.5rem;
		margin-bottom: 1.25rem;
	}

	section h2 {
		margin-top: 0;
	}

	section ul {
		padding-left: 1.25rem;
		color: var(--text-muted);
	}

	section a {
		color: var(--accent-strong);
	}
</style>
