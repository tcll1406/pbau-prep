---
import Base from '../../layouts/Base.astro';
import ExamensPage from '../../components/ExamensPage.astro';
import { EXAM_SUBJECTS } from '../../data/examens';

export async function getStaticPaths() {
	return EXAM_SUBJECTS.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
---

<Base
	title={`Exàmens anteriors — ${subject.label.ca}`}
	description={`Enunciats i criteris de correcció oficials de la UIB per a ${subject.label.ca}, organitzats per any i convocatòria.`}
>
	<ExamensPage subject={subject} lang="ca" />
</Base>
