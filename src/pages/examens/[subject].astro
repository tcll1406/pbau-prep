---
import { EXAM_SUBJECTS, OFFICIAL_DOCS, getExamArchive } from '../../data/examens';

export async function getStaticPaths() {
	return EXAM_SUBJECTS.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
const archive = getExamArchive(subject.slug);
const officialDocs = OFFICIAL_DOCS[subject.slug] ?? [];
---

<html lang="ca">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Exàmens anteriors — {subject.label} — PBAU Prep</title>
	</head>
	<body>
		<main>
			<h1>Exàmens anteriors — {subject.label}</h1>

			{archive.map((yearGroup) => (
				<section>
					<h2>{yearGroup.year}</h2>
					<ul>
						{yearGroup.convocatories.map((c) => (
							<li>
								{c.label}:
								<a href={c.enunciatUrl}>Enunciat</a>
								·
								<a href={c.criterisUrl}>Criteris</a>
							</li>
						))}
					</ul>
				</section>
			))}

			<section>
				<h2>Documents oficials</h2>
				<ul>
					{officialDocs.map((doc) => (
						<li><a href={doc.url}>{doc.label}</a></li>
					))}
				</ul>
			</section>
		</main>
	</body>
</html>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 1.5rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
	}
</style>
