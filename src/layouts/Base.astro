---
import { ICONS } from '../data/icons';
import { NAV_LINKS, UI, type Lang } from '../data/i18n';

interface Props {
	title: string;
	lang?: Lang;
	description?: string;
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const DEFAULT_DESCRIPTION: Record<Lang, string> = {
	ca: "Prepara la PAU a les Illes Balears: teoria, qüestionaris i exàmens anteriors de Física, Matemàtiques II i MACS II, més una calculadora de nota d'accés i un cercador de notes de tall.",
	es: 'Prepara la PAU en las Islas Baleares: teoría, cuestionarios y exámenes anteriores de Física, Matemáticas II y MACS II, más una calculadora de nota de acceso y un buscador de notas de corte.',
};

const { title, lang = 'ca', description = DEFAULT_DESCRIPTION[lang], noindex = false, structuredData } = Astro.props;

const pathname = Astro.url.pathname;
const altHref = lang === 'es' ? pathname.slice(3) || '/' : pathname === '/' ? '/es' : `/es${pathname}`;
const altLabel = lang === 'es' ? 'CA' : 'ES';
const loginHref = lang === 'es' ? '/es/login' : '/login';

const fullTitle = `${title} — PAU Balears Prep`;
const canonicalURL = new URL(pathname, Astro.site);
const alternateURL = new URL(altHref, Astro.site);
const ogImageURL = new URL('/favicon.png', Astro.site);
const googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<Fragment>
				<link rel="alternate" hreflang="ca" href={lang === 'es' ? alternateURL : canonicalURL} />
				<link rel="alternate" hreflang="es" href={lang === 'es' ? canonicalURL : alternateURL} />
				<link rel="alternate" hreflang="x-default" href={lang === 'es' ? alternateURL : canonicalURL} />
			</Fragment>
		)}
		{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="PAU Balears Prep" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'ca_ES'} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		{structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
	</head>
	<body>
		<header>
			<nav>
				<a class="brand" href={lang === 'es' ? '/es' : '/'}>
					<img src="/favicon.png" alt="" class="brand-icon" />
					PAU Balears Prep
				</a>
				<button id="nav-toggle" aria-expanded="false" aria-controls="nav-links">☰</button>
				<ul id="nav-links">
					{NAV_LINKS[lang].map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
					<li>
						<a class="nav-lang-toggle" href={altHref}>{altLabel}</a>
					</li>
					<li id="nav-auth-logged-out">
						<a href={loginHref} class="nav-user-btn" aria-label={UI[lang].login} set:html={ICONS.user} />
					</li>
					<li id="nav-auth-logged-in" hidden>
						<button id="nav-logout" type="button">{UI[lang].logout}</button>
					</li>
				</ul>
			</nav>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a1128;
		--surface: #131b3a;
		--surface-hover: #182252;
		--border: rgba(255, 255, 255, 0.08);
		--text: #f5f6fa;
		--text-muted: #9aa3b2;
		--accent: #2563eb;
		--accent-strong: #60a5fa;
		--gold: #facc15;
		--success: #22c55e;
		--radius: 1rem;
		--radius-sm: 0.6rem;
		--font: system-ui, -apple-system, "Segoe UI", sans-serif;

		--bg-light: #f5f1e8;
		--surface-light: #ffffff;
		--border-light: rgba(10, 17, 40, 0.1);
		--text-on-light: #1a1a2e;
		--text-muted-on-light: #5a5a6e;
	}

	html {
		background: var(--bg);
		color-scheme: dark;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
	}

	a {
		color: var(--accent-strong);
	}

	::selection {
		background: var(--accent);
		color: #fff;
	}
</style>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(10, 17, 40, 0.7);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: 75rem;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--text);
	}

	.brand-icon {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-sm);
	}

	#nav-toggle {
		display: none;
		background: none;
		border: none;
		color: var(--text);
		font-size: 1.5rem;
		cursor: pointer;
	}

	#nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	#nav-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s;
	}

	#nav-links a:hover {
		color: var(--text);
	}

	.nav-user-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 50%;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.2s, border-color 0.2s;
	}

	.nav-user-btn svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.nav-user-btn:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	#nav-logout {
		background: none;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		padding: 0.4rem 0.7rem;
		font-size: 0.85rem;
		font-family: var(--font);
		cursor: pointer;
		transition: color 0.2s, border-color 0.2s;
	}

	#nav-logout:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.nav-lang-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 50%;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 700;
		transition: color 0.2s, border-color 0.2s;
	}

	.nav-lang-toggle:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	@media (max-width: 40rem) {
		#nav-toggle {
			display: block;
		}

		#nav-links {
			display: none;
			flex-direction: column;
			gap: 0.75rem;
			width: 100%;
			margin-top: 1rem;
		}

		#nav-links.open {
			display: flex;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const links = document.getElementById('nav-links');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>

<script>
	import { supabase } from '../lib/supabase-client';

	const loggedOut = document.getElementById('nav-auth-logged-out')!;
	const loggedIn = document.getElementById('nav-auth-logged-in')!;
	const logoutBtn = document.getElementById('nav-logout')!;

	function render(email: string | null) {
		loggedOut.hidden = Boolean(email);
		loggedIn.hidden = !email;
	}

	supabase.auth.getSession().then(({ data }) => render(data.session?.user.email ?? null));
	supabase.auth.onAuthStateChange((_event, session) => render(session?.user.email ?? null));

	logoutBtn.addEventListener('click', async () => {
		await supabase.auth.signOut();
		window.location.href = '/';
	});
</script>
