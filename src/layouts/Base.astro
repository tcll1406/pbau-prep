---
interface Props {
	title: string;
}

const { title } = Astro.props;

const NAV_LINKS = [
	{ href: '/', label: 'Inici' },
	{ href: '/learning', label: 'Learning Hub' },
	{ href: '/career', label: 'Career Hub' },
	{ href: '/faq', label: 'FAQ' },
	{ href: '/about', label: 'Sobre nosaltres' },
];
---

<html lang="ca">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — PBAU Prep</title>
	</head>
	<body>
		<header>
			<nav>
				<a class="brand" href="/">PBAU Prep</a>
				<button id="nav-toggle" aria-expanded="false" aria-controls="nav-links">☰</button>
				<ul id="nav-links">
					{NAV_LINKS.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
					<li id="nav-auth-logged-out"><a href="/login">Inicia sessió</a></li>
					<li id="nav-auth-logged-in" hidden>
						<span id="nav-user-email" class="nav-user-email"></span>
						<button id="nav-logout" type="button">Tancar sessió</button>
					</li>
				</ul>
			</nav>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a1128;
		--surface: #131b3a;
		--surface-hover: #182252;
		--border: rgba(255, 255, 255, 0.08);
		--text: #f5f6fa;
		--text-muted: #9aa3b2;
		--accent: #3b82f6;
		--accent-strong: #60a5fa;
		--gold: #facc15;
		--success: #22c55e;
		--radius: 1rem;
		--radius-sm: 0.6rem;
		--font: system-ui, -apple-system, "Segoe UI", sans-serif;

		--bg-light: #f5f1e8;
		--surface-light: #ffffff;
		--border-light: rgba(10, 17, 40, 0.1);
		--text-on-light: #1a1a2e;
		--text-muted-on-light: #5a5a6e;
	}

	html {
		background: var(--bg);
		color-scheme: dark;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
	}

	a {
		color: var(--accent-strong);
	}

	::selection {
		background: var(--accent);
		color: #fff;
	}
</style>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(10, 17, 40, 0.7);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: 75rem;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font);
	}

	.brand {
		font-weight: 700;
		text-decoration: none;
		color: var(--text);
	}

	#nav-toggle {
		display: none;
		background: none;
		border: none;
		color: var(--text);
		font-size: 1.5rem;
		cursor: pointer;
	}

	#nav-links {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	#nav-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s;
	}

	#nav-links a:hover {
		color: var(--text);
	}

	#nav-auth-logged-in {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.nav-user-email {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	#nav-logout {
		background: none;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		padding: 0.3rem 0.7rem;
		font-size: 0.85rem;
		font-family: var(--font);
		cursor: pointer;
		transition: color 0.2s, border-color 0.2s;
	}

	#nav-logout:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	@media (max-width: 40rem) {
		#nav-toggle {
			display: block;
		}

		#nav-links {
			display: none;
			flex-direction: column;
			gap: 0.75rem;
			width: 100%;
			margin-top: 1rem;
		}

		#nav-links.open {
			display: flex;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const links = document.getElementById('nav-links');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>

<script>
	import { supabase } from '../lib/supabase-client';

	const loggedOut = document.getElementById('nav-auth-logged-out')!;
	const loggedIn = document.getElementById('nav-auth-logged-in')!;
	const userEmail = document.getElementById('nav-user-email')!;
	const logoutBtn = document.getElementById('nav-logout')!;

	function render(email: string | null) {
		loggedOut.hidden = Boolean(email);
		loggedIn.hidden = !email;
		userEmail.textContent = email ?? '';
	}

	supabase.auth.getSession().then(({ data }) => render(data.session?.user.email ?? null));
	supabase.auth.onAuthStateChange((_event, session) => render(session?.user.email ?? null));

	logoutBtn.addEventListener('click', async () => {
		await supabase.auth.signOut();
		window.location.href = '/';
	});
</script>
