---
interface Props {
	title: string;
}

const { title } = Astro.props;

const NAV_LINKS = [
	{ href: '/', label: 'Inici' },
	{ href: '/learning', label: 'Learning Hub' },
	{ href: '/career', label: 'Career Hub' },
	{ href: '/faq', label: 'FAQ' },
	{ href: '/about', label: 'Sobre nosaltres' },
];
---

<html lang="ca">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — PBAU Prep</title>
	</head>
	<body>
		<header>
			<nav>
				<a class="brand" href="/">PBAU Prep</a>
				<button id="nav-toggle" aria-expanded="false" aria-controls="nav-links">☰</button>
				<ul id="nav-links">
					{NAV_LINKS.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</nav>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a1128;
		--surface: #131b3a;
		--surface-hover: #182252;
		--border: rgba(255, 255, 255, 0.08);
		--text: #f5f6fa;
		--text-muted: #9aa3b2;
		--accent: #3b82f6;
		--accent-strong: #60a5fa;
		--gold: #facc15;
		--success: #22c55e;
		--radius: 1rem;
		--radius-sm: 0.6rem;
		--font: system-ui, -apple-system, "Segoe UI", sans-serif;
	}

	html {
		background: var(--bg);
		color-scheme: dark;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
	}

	a {
		color: var(--accent-strong);
	}

	::selection {
		background: var(--accent);
		color: #fff;
	}
</style>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(10, 17, 40, 0.7);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: 60rem;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font);
	}

	.brand {
		font-weight: 700;
		text-decoration: none;
		color: var(--text);
	}

	#nav-toggle {
		display: none;
		background: none;
		border: none;
		color: var(--text);
		font-size: 1.5rem;
		cursor: pointer;
	}

	#nav-links {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	#nav-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s;
	}

	#nav-links a:hover {
		color: var(--text);
	}

	@media (max-width: 40rem) {
		#nav-toggle {
			display: block;
		}

		#nav-links {
			display: none;
			flex-direction: column;
			gap: 0.75rem;
			width: 100%;
			margin-top: 1rem;
		}

		#nav-links.open {
			display: flex;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const links = document.getElementById('nav-links');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>
