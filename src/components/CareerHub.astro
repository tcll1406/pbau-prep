---
import type { Lang } from '../data/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const T = {
	ca: {
		calcTitle: "Calculadora de nota d'accés",
		faseGeneral: 'Fase General',
		mitjana: 'Mitjana de Batxillerat',
		hintExercicis: 'Nota dels 5 exercicis de la Fase General',
		faseEspecifica: 'Fase Específica (opcional, fins a 2 assignatures)',
		notaAssignatura1: 'Nota assignatura 1',
		notaAssignatura2: 'Nota assignatura 2',
		pes01: 'Pes 0.1',
		pes02: 'Pes 0.2',
		notaAcces: "Nota d'accés",
		notaEspecifica: 'Nota específica',
		notaAdmissio: "Nota d'admissió",
		objectiu: 'Objectiu:',
		notaDeTall: 'Nota de tall:',
		treureObjectiu: 'Treure objectiu',
		selectorGraus: 'Selector de graus',
		disclaimer:
			'La nota de tall canvia cada any segons la demanda de cada grau. Les notes d’anys anteriors són només orientatives, no una garantia d’admissió.',
		searchPlaceholder: 'Cerca un grau, universitat o ciutat…',
		totesComunitats: 'Totes les comunitats',
		totesCiutats: 'Totes les ciutats',
		totesUniversitats: 'Totes les universitats',
		assolible: 'Assolible amb la meva nota',
		hintSearch: 'Escriu per cercar entre els graus universitaris espanyols.',
	},
	es: {
		calcTitle: 'Calculadora de nota de acceso',
		faseGeneral: 'Fase General',
		mitjana: 'Media de Bachillerato',
		hintExercicis: 'Nota de los 5 ejercicios de la Fase General',
		faseEspecifica: 'Fase de Admisión (opcional, hasta 2 asignaturas)',
		notaAssignatura1: 'Nota asignatura 1',
		notaAssignatura2: 'Nota asignatura 2',
		pes01: 'Peso 0.1',
		pes02: 'Peso 0.2',
		notaAcces: 'Nota de acceso',
		notaEspecifica: 'Nota específica',
		notaAdmissio: 'Nota de admisión',
		objectiu: 'Objetivo:',
		notaDeTall: 'Nota de corte:',
		treureObjectiu: 'Quitar objetivo',
		selectorGraus: 'Selector de grados',
		disclaimer:
			'La nota de corte cambia cada año según la demanda de cada grado. Las notas de años anteriores son solo orientativas, no una garantía de admisión.',
		searchPlaceholder: 'Busca un grado, universidad o ciudad…',
		totesComunitats: 'Todas las comunidades',
		totesCiutats: 'Todas las ciudades',
		totesUniversitats: 'Todas las universidades',
		assolible: 'Alcanzable con mi nota',
		hintSearch: 'Escribe para buscar entre los grados universitarios españoles.',
	},
}[lang];
---

<main>
	<h1>Career Hub</h1>

	<div class="layout">
		<section class="calculator" aria-label={T.calcTitle}>
			<h2>{T.calcTitle}</h2>

			<fieldset>
				<legend>{T.faseGeneral}</legend>
				<label>
					{T.mitjana}
					<input type="number" id="batx" min="0" max="10" step="0.01" />
				</label>
				<p class="hint">{T.hintExercicis}</p>
				<div class="grid5">
					<input type="number" class="exercici" min="0" max="10" step="0.01" aria-label="Exercici 1" placeholder="Ex. 1" />
					<input type="number" class="exercici" min="0" max="10" step="0.01" aria-label="Exercici 2" placeholder="Ex. 2" />
					<input type="number" class="exercici" min="0" max="10" step="0.01" aria-label="Exercici 3" placeholder="Ex. 3" />
					<input type="number" class="exercici" min="0" max="10" step="0.01" aria-label="Exercici 4" placeholder="Ex. 4" />
					<input type="number" class="exercici" min="0" max="10" step="0.01" aria-label="Exercici 5" placeholder="Ex. 5" />
				</div>
			</fieldset>

			<fieldset>
				<legend>{T.faseEspecifica}</legend>
				<div class="subject-row">
					<input type="number" id="m1-grade" min="0" max="10" step="0.01" placeholder={T.notaAssignatura1} />
					<select id="m1-weight">
						<option value="0.1">{T.pes01}</option>
						<option value="0.2">{T.pes02}</option>
					</select>
				</div>
				<div class="subject-row">
					<input type="number" id="m2-grade" min="0" max="10" step="0.01" placeholder={T.notaAssignatura2} />
					<select id="m2-weight">
						<option value="0.1">{T.pes01}</option>
						<option value="0.2">{T.pes02}</option>
					</select>
				</div>
			</fieldset>

			<div class="results" id="results">
				<div class="result-row">
					<span>{T.notaAcces}</span>
					<strong id="out-acces">—</strong>
				</div>
				<div class="result-row">
					<span>{T.notaEspecifica}</span>
					<strong id="out-especifica">—</strong>
				</div>
				<div class="result-row result-final" id="out-admissio-row">
					<span>{T.notaAdmissio}</span>
					<strong id="out-admissio">—</strong>
				</div>
			</div>

			<div class="target" id="target-box" hidden>
				<span>{T.objectiu} <strong id="target-name"></strong></span>
				<span>{T.notaDeTall} <strong id="target-cutoff"></strong></span>
				<button id="target-clear" type="button">{T.treureObjectiu}</button>
			</div>
		</section>

		<section class="degrees" aria-label={T.selectorGraus}>
			<h2>{T.selectorGraus}</h2>
			<p class="disclaimer">{T.disclaimer}</p>

			<input type="search" id="degree-search" placeholder={T.searchPlaceholder} />

			<div class="filter-bar">
				<select id="filter-region">
					<option value="">{T.totesComunitats}</option>
				</select>
				<select id="filter-city" disabled>
					<option value="">{T.totesCiutats}</option>
				</select>
				<select id="filter-university">
					<option value="">{T.totesUniversitats}</option>
				</select>
				<label class="filter-checkbox">
					<input type="checkbox" id="filter-achievable" />
					{T.assolible}
				</label>
			</div>

			<p class="hint" id="degree-status">{T.hintSearch}</p>

			<ul class="degree-list" id="degree-list"></ul>
		</section>
	</div>
</main>

<style>
	main {
		max-width: 75rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		line-height: 1.6;
	}

	h1 {
		letter-spacing: -0.02em;
	}

	.layout {
		display: grid;
		grid-template-columns: 20rem 1fr;
		gap: 2rem;
		align-items: start;
		margin-top: 1.5rem;
	}

	@media (max-width: 48rem) {
		.layout {
			grid-template-columns: 1fr;
		}
	}

	.calculator,
	.degrees {
		min-width: 0;
	}

	.calculator {
		position: sticky;
		top: 5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem;
	}

	@media (max-width: 48rem) {
		.calculator {
			position: static;
		}
	}

	fieldset {
		min-width: 0;
		border: none;
		padding: 0;
		margin: 0 0 1.25rem;
	}

	legend {
		font-weight: 600;
		padding: 0;
		margin-bottom: 0.5rem;
	}

	label {
		display: block;
		font-size: 0.9rem;
		margin-bottom: 0.75rem;
	}

	input,
	select {
		display: block;
		width: 100%;
		box-sizing: border-box;
		padding: 0.5rem;
		margin-top: 0.25rem;
		background: var(--bg);
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 1rem;
	}

	input:focus,
	select:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.35);
	}

	.hint {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0 0 0.5rem;
	}

	.grid5 {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.4rem;
	}

	.grid5 input {
		min-width: 0;
		padding: 0.4rem 0.3rem;
		font-size: 0.85rem;
	}

	.subject-row {
		display: grid;
		grid-template-columns: 1fr 7rem;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.subject-row input,
	.subject-row select {
		min-width: 0;
		margin-top: 0;
	}

	.results {
		border-top: 1px solid var(--border);
		padding-top: 1rem;
	}

	.result-row {
		display: flex;
		justify-content: space-between;
		padding: 0.35rem 0;
	}

	.result-final {
		font-size: 1.2rem;
		border-radius: var(--radius-sm);
		padding: 0.5rem;
		transition: background-color 0.2s, box-shadow 0.2s;
	}

	.result-final.pass {
		background: rgba(34, 197, 94, 0.12);
		box-shadow: 0 0 0 2px var(--success), 0 0 20px rgba(34, 197, 94, 0.35);
	}

	.target {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.target button {
		width: auto;
		align-self: flex-start;
		background: var(--surface-hover);
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.35rem 0.75rem;
		cursor: pointer;
	}

	.disclaimer {
		font-size: 0.85rem;
		background: rgba(250, 204, 21, 0.1);
		border: 1px solid rgba(250, 204, 21, 0.4);
		border-radius: var(--radius-sm);
		padding: 0.75rem;
		color: var(--text);
	}

	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		margin: 0.75rem 0;
	}

	.filter-bar select {
		width: auto;
		margin-top: 0;
		flex: 1;
		min-width: 10rem;
	}

	.filter-checkbox {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.filter-checkbox input {
		width: auto;
		margin: 0;
	}

	.degree-list {
		list-style: none;
		padding: 0;
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	:global(.degree-list li) {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.75rem 1rem;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		transition: transform 0.2s, background 0.2s;
	}

	:global(.degree-list li:hover) {
		background: var(--surface-hover);
		transform: translateY(-2px);
	}

	:global(.degree-info strong) {
		display: block;
	}

	:global(.degree-info span) {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	:global(.degree-cutoff) {
		text-align: right;
		white-space: nowrap;
	}

	:global(.degree-list button) {
		width: auto;
		margin-top: 0.35rem;
		background: var(--accent);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm);
		padding: 0.35rem 0.75rem;
		font-size: 0.8rem;
		cursor: pointer;
		transition: background 0.2s;
	}

	:global(.degree-list button:hover) {
		background: #1d4ed8;
	}
</style>

<script>
	import { calculateGrade } from '../lib/grade-calculator';

	const SCRIPT_STRINGS = {
		ca: {
			invalid: 'No vàlida (Fase General < 4)',
			noneFound: 'Cap grau trobat.',
			typeToSearch: 'Escriu per cercar, o aplica un filtre, entre els graus universitaris espanyols.',
			results: 'resultat(s)',
			showingFirst: 'mostrant els primers',
			notaDeTall: 'Nota de tall:',
			noData: 'Sense dades',
			setTarget: 'Fixar com a objectiu',
		},
		es: {
			invalid: 'No válida (Fase General < 4)',
			noneFound: 'Ningún grado encontrado.',
			typeToSearch: 'Escribe para buscar, o aplica un filtro, entre los grados universitarios españoles.',
			results: 'resultado(s)',
			showingFirst: 'mostrando los primeros',
			notaDeTall: 'Nota de corte:',
			noData: 'Sin datos',
			setTarget: 'Fijar como objetivo',
		},
	}[location.pathname.startsWith('/es') ? 'es' : 'ca'];

	interface Degree {
		id: number;
		name: string;
		university: string;
		city: string;
		region: string | null;
		duration: number | null;
		cutoff: number | null;
	}

	function splitParts(value: string): string[] {
		return value.split(' / ').map((v) => v.trim()).filter(Boolean);
	}

	const batxInput = document.getElementById('batx') as HTMLInputElement;
	const exerciciInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.exercici'));
	const m1Grade = document.getElementById('m1-grade') as HTMLInputElement;
	const m1Weight = document.getElementById('m1-weight') as HTMLSelectElement;
	const m2Grade = document.getElementById('m2-grade') as HTMLInputElement;
	const m2Weight = document.getElementById('m2-weight') as HTMLSelectElement;

	const outAcces = document.getElementById('out-acces')!;
	const outEspecifica = document.getElementById('out-especifica')!;
	const outAdmissio = document.getElementById('out-admissio')!;
	const admissioRow = document.getElementById('out-admissio-row')!;

	const targetBox = document.getElementById('target-box')!;
	const targetName = document.getElementById('target-name')!;
	const targetCutoffEl = document.getElementById('target-cutoff')!;
	const targetClear = document.getElementById('target-clear')!;

	const searchInput = document.getElementById('degree-search') as HTMLInputElement;
	const regionFilter = document.getElementById('filter-region') as HTMLSelectElement;
	const cityFilter = document.getElementById('filter-city') as HTMLSelectElement;
	const cityPlaceholderText = cityFilter.querySelector('option')!.textContent!;
	const universityFilter = document.getElementById('filter-university') as HTMLSelectElement;
	const achievableFilter = document.getElementById('filter-achievable') as HTMLInputElement;
	const listEl = document.getElementById('degree-list')!;
	const statusEl = document.getElementById('degree-status')!;

	let targetCutoff: number | null = null;
	let currentAdmissio: number | null = null;
	let degrees: Degree[] = [];

	const MAX_RESULTS = 100;

	function num(input: HTMLInputElement): number {
		const v = Number(input.value);
		return Number.isFinite(v) ? v : 0;
	}

	function renderResults(query: string) {
		listEl.innerHTML = '';

		const q = query.trim().toLowerCase();
		const region = regionFilter.value;
		const city = cityFilter.value;
		const university = universityFilter.value;
		const achievableOnly = achievableFilter.checked;

		const hasActiveFilter = q.length >= 2 || region !== '' || city !== '' || university !== '' || achievableOnly;

		if (!hasActiveFilter) {
			statusEl.textContent = SCRIPT_STRINGS.typeToSearch;
			return;
		}

		const matches = degrees.filter((d) => {
			if (q && !(d.name.toLowerCase().includes(q) || d.university.toLowerCase().includes(q) || d.city.toLowerCase().includes(q))) {
				return false;
			}
			if (region && d.region !== region) return false;
			if (city && !splitParts(d.city).includes(city)) return false;
			if (university && !splitParts(d.university).includes(university)) return false;
			if (achievableOnly) {
				if (currentAdmissio === null || d.cutoff === null || d.cutoff > currentAdmissio) return false;
			}
			return true;
		});

		matches.sort((a, b) => {
			if (a.cutoff === null && b.cutoff === null) return 0;
			if (a.cutoff === null) return 1;
			if (b.cutoff === null) return -1;
			return b.cutoff - a.cutoff;
		});

		statusEl.textContent = matches.length
			? `${matches.length} ${SCRIPT_STRINGS.results}${matches.length > MAX_RESULTS ? `, ${SCRIPT_STRINGS.showingFirst} ${MAX_RESULTS}` : ''}`
			: SCRIPT_STRINGS.noneFound;

		for (const d of matches.slice(0, MAX_RESULTS)) {
			const li = document.createElement('li');

			const info = document.createElement('div');
			info.className = 'degree-info';
			const name = document.createElement('strong');
			name.textContent = d.name;
			const meta = document.createElement('span');
			meta.textContent = `${d.university} · ${d.city}`;
			info.append(name, meta);

			const cutoffBox = document.createElement('div');
			cutoffBox.className = 'degree-cutoff';
			cutoffBox.textContent = d.cutoff !== null ? `${SCRIPT_STRINGS.notaDeTall} ${d.cutoff.toFixed(3)}` : SCRIPT_STRINGS.noData;

			if (d.cutoff !== null) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = SCRIPT_STRINGS.setTarget;
				btn.addEventListener('click', () => setTarget(d));
				cutoffBox.appendChild(document.createElement('br'));
				cutoffBox.appendChild(btn);
			}

			li.append(info, cutoffBox);
			listEl.appendChild(li);
		}
	}

	function compute() {
		const result = calculateGrade(num(batxInput), exerciciInputs.map(num), [
			{ grade: num(m1Grade), weight: Number(m1Weight.value) },
			{ grade: num(m2Grade), weight: Number(m2Weight.value) },
		]);

		outEspecifica.textContent = result.especifica.toFixed(3);

		if (!result.valid) {
			outAcces.textContent = SCRIPT_STRINGS.invalid;
			outAdmissio.textContent = '—';
			admissioRow.classList.remove('pass');
			currentAdmissio = null;
			renderResults(searchInput.value);
			return;
		}

		outAcces.textContent = result.acces!.toFixed(3);
		outAdmissio.textContent = result.admissio!.toFixed(3);
		currentAdmissio = result.admissio;

		if (targetCutoff !== null && result.admissio! >= targetCutoff) {
			admissioRow.classList.add('pass');
		} else {
			admissioRow.classList.remove('pass');
		}

		renderResults(searchInput.value);
	}

	[batxInput, ...exerciciInputs, m1Grade, m1Weight, m2Grade, m2Weight].forEach((el) =>
		el.addEventListener('input', compute)
	);
	compute();

	function setTarget(degree: Degree) {
		if (degree.cutoff === null) return;
		targetCutoff = degree.cutoff;
		targetName.textContent = degree.name;
		targetCutoffEl.textContent = degree.cutoff.toFixed(3);
		targetBox.hidden = false;
		compute();
	}

	targetClear.addEventListener('click', () => {
		targetCutoff = null;
		targetBox.hidden = true;
		compute();
	});

	searchInput.addEventListener('input', () => renderResults(searchInput.value));
	regionFilter.addEventListener('change', () => {
		populateCityOptions(regionFilter.value);
		renderResults(searchInput.value);
	});
	cityFilter.addEventListener('change', () => renderResults(searchInput.value));
	universityFilter.addEventListener('change', () => renderResults(searchInput.value));
	achievableFilter.addEventListener('change', () => renderResults(searchInput.value));

	function populateCityOptions(region: string) {
		cityFilter.innerHTML = '';
		const placeholder = document.createElement('option');
		placeholder.value = '';
		placeholder.textContent = cityPlaceholderText;
		cityFilter.appendChild(placeholder);

		const scoped = region ? degrees.filter((d) => d.region === region) : degrees;
		const cities = [...new Set(scoped.flatMap((d) => splitParts(d.city)))].sort();
		for (const city of cities) {
			const opt = document.createElement('option');
			opt.value = city;
			opt.textContent = city;
			cityFilter.appendChild(opt);
		}
		cityFilter.value = '';
		cityFilter.disabled = !region;
	}

	function populateFilterOptions() {
		const regions = [...new Set(degrees.map((d) => d.region).filter((r): r is string => Boolean(r)))].sort();
		const universities = [...new Set(degrees.flatMap((d) => splitParts(d.university)))].sort();

		for (const region of regions) {
			const opt = document.createElement('option');
			opt.value = region;
			opt.textContent = region;
			regionFilter.appendChild(opt);
		}
		for (const uni of universities) {
			const opt = document.createElement('option');
			opt.value = uni;
			opt.textContent = uni;
			universityFilter.appendChild(opt);
		}
	}

	fetch('/data/degrees.json')
		.then((res) => res.json())
		.then((data: Degree[]) => {
			degrees = data;
			populateFilterOptions();
			renderResults(searchInput.value);
		});
</script>
