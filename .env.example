# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase (Stage 5 — quiz question bank, read at build time only)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (Stage 6 — client-side auth, same project/key as above, PUBLIC_ prefix
# so Vite ships it to the browser bundle; safe, it's the anon key, RLS-protected)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Example: API keys for tools/ scripts
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Search Console site-ownership verification (Stage 16, optional,
# read at build time only — get the value from Search Console's "HTML tag" method)
GOOGLE_SITE_VERIFICATION=

# Google OAuth (credentials.json / token.json are generated separately,
# see https://developers.google.com/workspace/guides/create-credentials)
